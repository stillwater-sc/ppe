# Doxygen configuration for the PPE C++ API reference.
#
# Output lands in public/api/, which Astro serves as a static asset at
# <base>/api/ -- see the sidebar entry in astro.config.mjs. Generated by
# `npm run api`; the directory is .gitignored.

PROJECT_NAME           = "PPE -- Platform Performance Engineering C++ API"
PROJECT_BRIEF          = "ppe:: -- platform attribute detection, measurement harnesses, and tools"
OUTPUT_DIRECTORY       = public
HTML_OUTPUT            = api
GENERATE_LATEX         = NO
INPUT                  = ../include/ppe
RECURSIVE              = YES
FILE_PATTERNS          = *.hpp *.h
EXTRACT_ALL            = YES
EXTRACT_STATIC         = YES
JAVADOC_AUTOBRIEF      = YES
QUIET                  = YES
WARN_IF_UNDOCUMENTED   = NO
GENERATE_TREEVIEW      = YES
DISABLE_INDEX          = NO
FULL_SIDEBAR           = NO
ALPHABETICAL_INDEX     = YES
SORT_MEMBER_DOCS       = YES
SOURCE_BROWSER         = NO
VERBATIM_HEADERS       = NO
HAVE_DOT               = NO
BUILTIN_STL_SUPPORT    = YES
