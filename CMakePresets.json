{
    "version": 3,
    "cmakeMinimumRequired": { "major": 3, "minor": 22, "patch": 0 },
    "configurePresets": [
        {
            "name": "dev",
            "displayName": "Development (Debug, Ninja)",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_CXX_STANDARD": "20",
                "PPE_BUILD_APPLICATIONS": "ON",
                "PPE_BUILD_BENCHMARKS": "ON",
                "PPE_BUILD_TOOLS": "ON",
                "PPE_BUILD_TESTS": "ON",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
            }
        },
        {
            "name": "release",
            "displayName": "Release (measurement builds, host-tuned)",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build-release",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_CXX_STANDARD": "20",
                "PPE_BUILD_APPLICATIONS": "ON",
                "PPE_BUILD_BENCHMARKS": "ON",
                "PPE_BUILD_TOOLS": "ON",
                "PPE_BUILD_TESTS": "ON",
                "PPE_NATIVE_ARCH": "ON"
            }
        },
        {
            "name": "ci",
            "displayName": "CI (Release, portable baseline)",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build-ci",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_CXX_STANDARD": "20",
                "PPE_BUILD_APPLICATIONS": "ON",
                "PPE_BUILD_BENCHMARKS": "ON",
                "PPE_BUILD_TOOLS": "ON",
                "PPE_BUILD_TESTS": "ON",
                "PPE_NATIVE_ARCH": "OFF"
            }
        },
        {
            "name": "msvc",
            "displayName": "Windows (Visual Studio 2022, x64)",
            "generator": "Visual Studio 17 2022",
            "architecture": "x64",
            "binaryDir": "${sourceDir}/build-msvc",
            "cacheVariables": {
                "CMAKE_CXX_STANDARD": "20",
                "PPE_BUILD_APPLICATIONS": "ON",
                "PPE_BUILD_BENCHMARKS": "ON",
                "PPE_BUILD_TOOLS": "ON",
                "PPE_BUILD_TESTS": "ON"
            }
        }
    ],
    "buildPresets": [
        { "name": "dev",     "configurePreset": "dev" },
        { "name": "release", "configurePreset": "release" },
        { "name": "ci",      "configurePreset": "ci" },
        { "name": "msvc",    "configurePreset": "msvc", "configuration": "Release" }
    ],
    "testPresets": [
        {
            "name": "dev",
            "configurePreset": "dev",
            "output": { "outputOnFailure": true }
        },
        {
            "name": "release",
            "configurePreset": "release",
            "output": { "outputOnFailure": true }
        },
        {
            "name": "ci",
            "configurePreset": "ci",
            "output": { "outputOnFailure": true }
        },
        {
            "name": "msvc",
            "configurePreset": "msvc",
            "configuration": "Release",
            "output": { "outputOnFailure": true }
        }
    ]
}
